# Set the key for the Decisions surface you use. The endpoint follows the key:
#   REQUESTY_API_KEY   -> https://router.requesty.ai/v1/systemone (typesafe/jev-1.14.0)
#   OPENROUTER_API_KEY -> https://openrouter.ai/api/alpha/decisions (typesafe/jev-1.13)
# Requesty wins when both are present. No separate TypeSafe credential is needed.
REQUESTY_API_KEY=
# OPENROUTER_API_KEY=
